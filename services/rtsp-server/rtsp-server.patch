+static bool accepted(const std::string& key, const std::string& value, std::initializer_list<const char*> values)
+{
+	std::string list;
+
+	for (const char* v : values) {
+		if (value == v) {
+			return true;
+		}
+
+		list += list.empty() ? v : std::string(", ") + v;
+	}
+
+	std::cerr << "[camera] " << key << ": \"" << value << "\" refused, accepted: " << list << std::endl;
+	return false;
+}
