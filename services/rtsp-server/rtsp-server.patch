+	// v4l2src on GStreamer 1.20 has no 10-bit Bayer caps, so the sensor is read as Y16 and cut to 8 bits.
+	ss << "( v4l2src device=" << _cameraConfig.device << " do-timestamp=true ! "
+	   << "video/x-raw,format=GRAY16_LE,width=" << w << ",height=" << h << ",framerate=" << fps << "/1 ! "
+	   << "videoconvert ! video/x-raw,format=GRAY8 ! ";
+
+	// join=false: merging the Bayer caps into the GRAY8 caps fails to link.
+	if (_cameraConfig.bayer != "mono") {
+		ss << "capssetter join=false replace=true caps=\"video/x-bayer,format=" << _cameraConfig.bayer
+		   << ",width=" << w << ",height=" << h << ",framerate=" << fps << "/1\" ! "
+		   << "bayer2rgb ! video/x-raw,format=BGRx ! ";
+	}
+
+	ss << jetson_encode(w, h, fps);
+	return ss.str();
+}
