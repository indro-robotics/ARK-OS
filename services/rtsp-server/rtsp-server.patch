+std::string resolve_encoder(const std::string& encoder)
+{
+	gst::gst_init(nullptr, nullptr);
+
+	const auto installed = [](const std::string & name) {
+		gst::GstElementFactory* factory = gst::gst_element_factory_find(name.c_str());
+
+		if (factory) {
+			gst::gst_object_unref(factory);
+		}
+
+		return factory != nullptr;
+	};
+
+	if (encoder != "auto") {
+		return installed(encoder) ? encoder : "";
+	}
+
+	// The encoder element alone does not prove an NVENC engine: Orin Nano has none.
+	std::error_code ec;
+	bool nvenc = false;
+
+	for (const auto& dev : std::filesystem::directory_iterator("/sys/bus/platform/devices", ec)) {
+		nvenc = nvenc || dev.path().extension() == ".nvenc";
+	}
+
+	return nvenc && installed("nvv4l2h264enc") ? "nvv4l2h264enc" : "x264enc";
+}
